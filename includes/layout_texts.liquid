<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{ title }} on ilium</title>
        <link rel="stylesheet" href="../main.css">
    </head>
    <body>
        <div id="front_matter">
            <table id="metadata">
                <h1 id="text_title">{{ title }}</h1>
                <i id="text_blurb">on <b>ilium</b>, a free archive of ancient texts</i>
                <h2>Metadata</h2>
                <tr>
                    <td><b>Author</b></td>
                    <td>{{ author }}</td>
                </tr>
                <tr>
                    <td><b>Date Written</b></td>
                    <td>{{ date_written }}</td>
                </tr>
                <tr>
                    <td><b>Translator</b></td>
                    <td>{{ translator }}</td>
                </tr>
                <tr>
                    <td><b>Date Translated</b></td>
                    <td>{{ date_translated }}</td>
                </tr>
                <tr>
                    <td><b>Source</b></td>
                    <td><a href="{{ source_url }}">{{ source_name }}</a></td>
                </tr>
            </table>
        </div>

        <hr>

        <div id="content">
            {{ content }}
        </div>
    </body>
</html>