<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{ title }} on ilium</title>
    </head>
    <body>
        <div id="front_matter">
            <h1>{{ title }}</h1>
            <p>Author: {{ author }}</p>
            <p>Translator: {{ translator }}</p>
            <a href="{{ source_url }}">Source</a>
        </div>

        <hr>

        <div id="content">{{ content }}</div>
    </body>
</html>